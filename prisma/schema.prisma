generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  VENDOR
  CUSTOMER
  DELIVERY_MAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuthProvider {
  LOCAL
  GOOGLE
  FACEBOOK
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
  OUT_OF_STOCK
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StoreVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum StockLogType {
  INCREASE
  DECREASE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  ASSIGNED_TO_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum DeliveryStatus {
  NOT_ASSIGNED
  ASSIGNED
  ACCEPTED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum PaymentMethod {
  COD
  MANUAL_BKASH
  MANUAL_NAGAD
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  FAILED
  REJECTED
  REFUNDED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  WITHDRAWAL
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  phone        String?      @unique
  passwordHash String?
  avatarUrl    String?
  role         UserRole     @default(CUSTOMER)
  status       UserStatus   @default(ACTIVE)
  authProvider AuthProvider @default(LOCAL)
  providerId   String?

  products       Product[]  @relation("VendorProducts")
  store          Store?
  customerOrders Order[]    @relation("CustomerOrders")
  deliveryOrders Order[]    @relation("DeliveryOrders")
  reviewedPayments Payment[] @relation("PaymentReviewedBy")
  commissionRules CommissionRule[]
  stockLogs      StockLog[] @relation("StockLogChangedBy")
  reviews        Review[]
  wallet         Wallet?
  cart           Cart?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authProvider, providerId])
  @@index([role])
  @@index([status])
}

model Store {
  id                 String                  @id @default(uuid())
  vendorId           String                  @unique
  name               String
  slug               String                  @unique
  description        String?
  logoUrl            String?
  logoPublicId       String?
  bannerUrl          String?
  bannerPublicId     String?
  phone              String?
  address            Json?
  status             StoreStatus             @default(ACTIVE)
  verificationStatus StoreVerificationStatus @default(PENDING)
  commissionRate     Decimal                 @default(10) @db.Decimal(5, 2)

  vendor     User        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  products   Product[]
  orderItems OrderItem[]
  stockLogs  StockLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([verificationStatus])
}

model Category {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  description   String?
  parentId      String?
  status        CategoryStatus @default(ACTIVE)
  imageUrl      String?
  imagePublicId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  commissionRules CommissionRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([status])
}

model HomeBanner {
  id            String  @id @default(uuid())
  imageUrl      String
  imagePublicId String?
  redirectLink  String  @default("/products")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id         String  @id @default(uuid())
  vendorId   String
  storeId    String
  categoryId String?

  name           String
  slug           String        @unique
  description    String?
  price          Decimal       @db.Decimal(10, 2)
  discountPrice  Decimal?      @db.Decimal(10, 2)
  stock          Int           @default(0)
  sku            String?       @unique
  images         String[]      @default([])
  imagePublicIds String[]      @default([])
  status         ProductStatus @default(DRAFT)
  avgRating      Decimal       @default(0) @db.Decimal(3, 2)
  reviewsCount   Int           @default(0)

  vendor     User        @relation("VendorProducts", fields: [vendorId], references: [id], onDelete: Cascade)
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  commissionRules CommissionRule[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  stockLogs  StockLog[]
  reviews    Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@index([slug])
}

model StockLog {
  id            String       @id @default(uuid())
  productId     String
  storeId       String
  changedById   String?
  type          StockLogType
  quantity      Int
  previousStock Int
  newStock      Int
  reason        String?
  reference     String?

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("StockLogChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([storeId])
  @@index([changedById])
  @@index([type])
  @@index([reference])
}

model Cart {
  id         String     @id @default(uuid())
  customerId String     @unique
  customer   User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model DeliveryZone {
  id                    String   @id @default(uuid())
  name                  String
  slug                  String             @unique
  district              String   @default("Feni")
  area                  String
  baseCharge            Decimal  @db.Decimal(10, 2)
  sameDayCharge         Decimal? @db.Decimal(10, 2)
  freeDeliveryMinAmount Decimal? @db.Decimal(10, 2)
  estimatedDeliveryTime String?
  isActive              Boolean  @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([district, area])
}

model Order {
  id             String @id @default(uuid())
  orderNumber    String @unique
  customerId     String
  deliveryManId  String?
  deliveryZoneId String?

  status          OrderStatus    @default(PENDING)
  deliveryStatus  DeliveryStatus @default(NOT_ASSIGNED)
  paymentMethod   PaymentMethod  @default(COD)
  paymentStatus   PaymentStatus  @default(UNPAID)
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryCharge  Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  shippingAddress Json
  customerNote    String?
  vendorSettledAt DateTime?

  customer     User          @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  deliveryMan  User?         @relation("DeliveryOrders", fields: [deliveryManId], references: [id], onDelete: SetNull)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payment      Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([deliveryManId])
  @@index([deliveryZoneId])
  @@index([status])
  @@index([deliveryStatus])
  @@index([paymentStatus])
  @@index([vendorSettledAt])
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  productId       String
  vendorId        String
  storeId         String
  quantity        Int
  unitPrice       Decimal        @db.Decimal(10, 2)
  priceSnapshot   Decimal        @db.Decimal(10, 2)
  totalPrice      Decimal        @db.Decimal(10, 2)
  subtotal        Decimal        @db.Decimal(10, 2)
  commissionType  CommissionType @default(PERCENTAGE)
  commissionValue Decimal        @default(0) @db.Decimal(10, 2)
  adminCommission Decimal        @default(0) @db.Decimal(10, 2)
  commissionAmount Decimal       @default(0) @db.Decimal(10, 2)
  vendorEarning   Decimal        @default(0) @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([vendorId])
  @@index([storeId])
}

model Review {
  id         String       @id @default(uuid())
  productId  String
  customerId String
  rating     Int
  comment    String?
  status     ReviewStatus @default(PUBLISHED)

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, customerId])
  @@index([productId])
  @@index([customerId])
  @@index([status])
}

model Payment {
  id                        String        @id @default(uuid())
  orderId                   String        @unique
  paymentMethod             PaymentMethod
  paymentStatus             PaymentStatus @default(UNPAID)
  transactionId             String?       @unique
  senderPhone               String?
  paymentScreenshotUrl      String?
  paymentScreenshotPublicId String?
  amount                    Decimal       @db.Decimal(10, 2)
  metadata                  Json?
  reviewedById              String?
  reviewedAt                DateTime?
  rejectionReason           String?

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PaymentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentMethod])
  @@index([paymentStatus])
  @@index([reviewedById])
}

model CommissionRule {
  id              String         @id @default(uuid())
  vendorId        String?
  categoryId      String?
  productId       String?
  commissionType  CommissionType
  commissionValue Decimal        @db.Decimal(10, 2)
  priority        Int
  isActive        Boolean        @default(true)
  startsAt        DateTime?
  endsAt          DateTime?

  vendor   User?     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([categoryId])
  @@index([productId])
  @@index([isActive])
  @@index([priority])
}

model Setting {
  id          String  @id @default(uuid())
  key         String  @unique
  value       String
  type        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Wallet {
  id             String  @id @default(uuid())
  vendorId       String  @unique
  balance        Decimal @default(0) @db.Decimal(10, 2)
  pendingBalance Decimal @default(0) @db.Decimal(10, 2)

  vendor       User                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  withdrawals  WithdrawalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id        String                @id @default(uuid())
  walletId  String
  type      WalletTransactionType
  amount    Decimal               @db.Decimal(10, 2)
  reference String?
  reason    String?
  metadata  Json?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([walletId, type, reference])
  @@index([walletId])
  @@index([type])
}

model WithdrawalRequest {
  id            String           @id @default(uuid())
  walletId      String
  amount        Decimal          @db.Decimal(10, 2)
  status        WithdrawalStatus @default(PENDING)
  paymentMethod String
  accountNumber String
  note          String?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([status])
}
